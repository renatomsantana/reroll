# =================================================================================================
# MODELO. Copie pra `keystore.properties` (sem o `.exemplo`) e preencha — o arquivo de verdade fica
# só na sua máquina, nunca no repositório.
#
# A chave em si você cria com o comando que está em COMO-PUBLICAR-NA-PLAY-STORE.txt. Guarde uma
# cópia dela FORA do computador: perdida a chave, o app publicado não tem como receber update nunca
# mais, e a Play Store não abre exceção.

# Caminho do arquivo .jks, relativo à pasta `android/`.
storeFile=reroll.jks
storePassword=
keyAlias=reroll
keyPassword=
